[configuration]

entry_symbol = "godot_recycler_view_library_init"
compatibility_minimum = "4.1"
reloadable = true

[libraries]
; Relative paths ensure that our GDExtension can be placed anywhere in the project directory.
;
; This list is the contract for the release package: every entry must be a file
; the build actually produces, and every produced file must be listed here.
; script/scan.sh enforces both directions and runs in the release workflow.
;
; Names follow godot-cpp's suffix rule (tools/godotcpp.py):
;   <platform>.<target>[.dev][.precision].<arch>[.simulator][.nothreads]
; so a double-precision build would be ".double" BEFORE the arch, e.g.
;   libgodot-recycler-view.linux.template_debug.double.x86_64.so
; Precision is omitted for single, and ".nothreads" only appears when a build
; passes threads=no (the default is threads on). macOS builds universal by
; default and scons drops the ".universal" token.
macos.single.debug = "./macos/libgodot-recycler-view.macos.template_debug.dylib"
macos.single.release = "./macos/libgodot-recycler-view.macos.template_release.dylib"

ios.arm64.single.debug = "./ios/libgodot-recycler-view.ios.template_debug.arm64.dylib"
ios.arm64.single.release = "./ios/libgodot-recycler-view.ios.template_release.arm64.dylib"

windows.x86_32.single.debug = "./windows/godot-recycler-view.windows.template_debug.x86_32.dll"
windows.x86_32.single.release = "./windows/godot-recycler-view.windows.template_release.x86_32.dll"

windows.x86_64.single.debug = "./windows/godot-recycler-view.windows.template_debug.x86_64.dll"
windows.x86_64.single.release = "./windows/godot-recycler-view.windows.template_release.x86_64.dll"

linux.x86_32.single.debug = "./linux/libgodot-recycler-view.linux.template_debug.x86_32.so"
linux.x86_32.single.release = "./linux/libgodot-recycler-view.linux.template_release.x86_32.so"

linux.x86_64.single.debug = "./linux/libgodot-recycler-view.linux.template_debug.x86_64.so"
linux.x86_64.single.release = "./linux/libgodot-recycler-view.linux.template_release.x86_64.so"

linux.arm32.single.debug = "./linux/libgodot-recycler-view.linux.template_debug.arm32.so"
linux.arm32.single.release = "./linux/libgodot-recycler-view.linux.template_release.arm32.so"

linux.arm64.single.debug = "./linux/libgodot-recycler-view.linux.template_debug.arm64.so"
linux.arm64.single.release = "./linux/libgodot-recycler-view.linux.template_release.arm64.so"

android.x86_32.single.debug = "./android/libgodot-recycler-view.android.template_debug.x86_32.so"
android.x86_32.single.release = "./android/libgodot-recycler-view.android.template_release.x86_32.so"

android.x86_64.single.debug = "./android/libgodot-recycler-view.android.template_debug.x86_64.so"
android.x86_64.single.release = "./android/libgodot-recycler-view.android.template_release.x86_64.so"

android.arm32.single.debug = "./android/libgodot-recycler-view.android.template_debug.arm32.so"
android.arm32.single.release = "./android/libgodot-recycler-view.android.template_release.arm32.so"

android.arm64.single.debug = "./android/libgodot-recycler-view.android.template_debug.arm64.so"
android.arm64.single.release = "./android/libgodot-recycler-view.android.template_release.arm64.so"

web.wasm32.single.debug = "./web/libgodot-recycler-view.web.template_debug.wasm32.wasm"
web.wasm32.single.release = "./web/libgodot-recycler-view.web.template_release.wasm32.wasm"
